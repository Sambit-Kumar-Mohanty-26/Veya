# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional. Leaving GEMINI_MODEL unset enables fallback across several flash
# models, which matters because the free tier is 20 requests/day PER MODEL.
# Setting it pins one model and disables the fallback.
# GEMINI_MODEL=gemini-3.6-flash                    (one model, or a comma-separated list)
# GEMINI_TIMEOUT_MS=120000
# GEMINI_MAX_OUTPUT_TOKENS=32768

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGIN=http://localhost:3000
